# ═══════════════════════════════════════════════════════════
# RolBotV1 — Variables de Entorno
# Copia este archivo como .env.local y completa los valores
# ═══════════════════════════════════════════════════════════

# --- Supabase (REQUERIDO) ---
SUPABASE_URL=tu_url_de_supabase_aqui
# Clave secreta service_role del backend. Nunca uses una clave anon/publishable.
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui
# Compatibilidad temporal (deprecada): SUPABASE_KEY=tu_service_role_key_aqui

# --- Owner del bot ---
# Teléfono del owner (formato: código de país + número, ej. sintético: 15550000000)
OWNER_PHONE=
# Aliases del owner separados por coma (JIDs de WhatsApp)
OWNER_ALIASES=

# --- Pairing code (opcional) ---
# Solo se usa si se ejecuta con: npm start code
# Formato: código de país + número sin espacios ni signos (ej: 521234567890)
PAIRING_PHONE_NUMBER=

# --- Connection timeouts (ms) ---
CONNECT_TIMEOUT_MS=120000
QUERY_TIMEOUT_MS=90000
MAX_RECONNECT_ATTEMPTS=50
