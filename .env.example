# Teléfono para pairing code (solo se usa si se ejecuta con: npm start code)
# Si no se define, el bot pedirá el número por terminal interactivamente
# Formato: código de país + número sin espacios ni signos (ej: 521234567890)
PAIRING_PHONE_NUMBER=

# Connection timeouts (ms)
CONNECT_TIMEOUT_MS=120000
QUERY_TIMEOUT_MS=90000
MAX_RECONNECT_ATTEMPTS=50
