# ═══════════════════════════════════════════════════════════
# RolBotV1 — Variables de Entorno (Producción Oracle Cloud)
# Copia esto como .env.production y completa los valores
# ═══════════════════════════════════════════════════════════

# --- Supabase (REQUERIDO) ---
SUPABASE_URL=tu_url_de_supabase_aqui
SUPABASE_KEY=tu_service_role_key_aqui

# --- Owner del bot ---
OWNER_PHONE=
OWNER_ALIASES=

# --- Pairing code (opcional) ---
PAIRING_PHONE_NUMBER=

# --- Connection timeouts (ms) ---
CONNECT_TIMEOUT_MS=120000
QUERY_TIMEOUT_MS=90000
MAX_RECONNECT_ATTEMPTS=50
