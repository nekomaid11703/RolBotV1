{
	"mcpServers": {
		"nekomemori": {
			"command": "node",
			"args": [
				"../mcp_nekomemori/index.js"
			]
		},
		"github": {
			"type": "streamable-http",
			"url": "https://api.githubcopilot.com/mcp/",
			"headers": {
				"Authorization": "Bearer ${env:GITHUB_PERSONAL_ACCESS_TOKEN}"
			}
		}
	}
}
