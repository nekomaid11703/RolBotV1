{
  "name": "rolbotv1",
  "version": "1.0.0",
  "description": "Bot RPG modular para WhatsApp",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "lint": "eslint src/ --cache",
    "lint:fix": "eslint src/ --cache --fix",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\" \"index.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.js\" \"index.js\"",
    "typecheck": "tsc --noEmit --incremental",
    "depcruise": "depcruise src",
    "depcruise:graph": "depcruise src --output-type dot | dot -T svg > graphify-out/dependency-graph.svg",
    "test": "vitest run",
    "test:watch": "vitest",
    "knip": "node scripts/knip-wrapper.mjs",
    "audit": "npm audit",
    "check": "npm run lint && npm run typecheck && npm run depcruise",
    "tools:list": "node scripts/tools-list.js",
    "check:all": "npm run lint && npm run typecheck && npm run depcruise && npm run format:check && npm test",
    "prepare": "husky",
    "graphify:extract": "python -m graphify extract . --code-only --out .",
    "graphify:update": "python -m graphify update .",
    "graphify:cluster": "python -m graphify cluster-only .",
    "graphify:rebuild": "npm run graphify:extract && npm run graphify:cluster",
    "graphify:watch": "python -m graphify watch .",
    "graphify:query": "python -m graphify query",
    "graphify:path": "python -m graphify path",
    "graphify:explain": "python -m graphify explain",
    "graphify:hook:install": "python -m graphify hook install",
    "graphify:opencode:install": "python -m graphify opencode install"
  },
  "keywords": [
    "whatsapp",
    "bot",
    "rpg",
    "baileys"
  ],
  "author": "NekoMaid",
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "@whiskeysockets/baileys": "^6.7.23",
    "dotenv": "^17.4.2",
    "pino": "^9.14.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "dependency-cruiser": "^18.1.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^63.0.13",
    "eslint-plugin-sonarjs": "^4.2.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jsdoc-scribe": "^2.4.8",
    "knip": "^6.26.0",
    "lint-staged": "^17.0.8",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "src/**/*.js": [
      "prettier --write",
      "eslint --cache --fix"
    ],
    "*.js": [
      "prettier --write"
    ]
  }
}
