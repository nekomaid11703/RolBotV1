{
  "name": "rolbotv1",
  "version": "1.0.0",
  "description": "Bot RPG modular para WhatsApp",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\" \"index.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.js\" \"index.js\"",
    "typecheck": "tsc --noEmit",
    "depcruise": "depcruise src",
    "depcruise:graph": "depcruise src --output-type dot | dot -T svg > graphify-out/dependency-graph.svg",
    "test": "vitest run",
    "test:watch": "vitest",
    "knip": "knip",
    "audit": "npm audit",
    "check": "npm run lint && npm run typecheck && npm run depcruise",
    "tools:list": "node scripts/tools-list.js",
    "check:all": "npm run lint && npm run typecheck && npm run depcruise && npm run format:check && npm test",
    "prepare": "husky",
    "graphify:status": "graphify check-update .",
    "graphify:extract": "graphify update . --force --no-cluster",
    "graphify:update": "graphify update .",
    "graphify:cluster": "graphify cluster-only .",
    "graphify:rebuild": "graphify update . --force",
    "graphify:watch": "graphify watch .",
    "graphify:query": "graphify query",
    "graphify:path": "graphify path",
    "graphify:explain": "graphify explain",
    "graphify:hook:install": "graphify hook install",
    "graphify:opencode:install": "graphify opencode install"
  },
  "keywords": [
    "whatsapp",
    "bot",
    "rpg",
    "baileys"
  ],
  "author": "NekoMaid",
  "license": "ISC",
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "@whiskeysockets/baileys": "^6.7.23",
    "dotenv": "^17.4.2",
    "pino": "^9.14.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "dependency-cruiser": "^18.1.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "knip": "^6.26.0",
    "lint-staged": "^17.0.8",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.js": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
