{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/core/bot.js",
    "src/commands/**/*.js",
    "src/data/**/*.js",
    "src/config/**/*.js",
    "scripts/**/*.js",
    "tests/**/*.js"
  ],
  "project": ["src/**/*.js"],
  "ignore": ["scripts/simulate_combat/backup_battery/**"],
  "rules": {
    "files": "warn",
    "exports": "warn",
    "dependencies": "off",
    "devDependencies": "off"
  },
  "ignoreBinaries": ["dot"]
}
