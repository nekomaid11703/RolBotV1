echo "✅ post-commit: running quality checks in parallel..."
npm run lint --silent 2>/dev/null && echo "   ✅ lint passed" || echo "   ⚠️ lint found issues (non-blocking)" &
npm run typecheck --silent 2>/dev/null && echo "   ✅ types passed" || echo "   ⚠️ typecheck found issues (non-blocking)" &
npm run depcruise --silent 2>/dev/null && echo "   ✅ dependency check passed" || echo "   ⚠️ depcruise found issues (non-blocking)" &
wait
echo "✅ post-commit: updating graphify knowledge graph..."
npm run graphify:update 2>/dev/null && echo "   ✅ graphify updated" || echo "   ⚠️ graphify update skipped (not available)"
